; lumnd/plato-workerman. The authority on PHP style is phpcs.xml; this file only covers what an editor decides
; before a linter ever sees the file.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.php]
indent_size = 4
; PSR-12 makes 120 a soft limit and forbids enforcing it hard, so this is a guide, not a rule
max_line_length = 120

[*.{yml,yaml,json,neon,xml}]
indent_size = 2

[*.md]
; Two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
